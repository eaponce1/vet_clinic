<!DOCTYPE html>
<html>
  <head>
    <title>VetClinic</title>

    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
      <div class="container-fluid">

        <!-- LOGO -->
        <%= link_to "VetClinic", root_path, class: "navbar-brand fw-bold" %>

        <!-- BOTON HAMBURGUESA -->
        <button class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav">
          <span class="navbar-toggler-icon"></span>
        </button>

        <!-- NAVBAR CONTENT -->
        <div class="collapse navbar-collapse" id="navbarNav">

          <!-- LEFT LINKS -->
          <ul class="navbar-nav me-auto">

            <% if user_signed_in? %>

              <% if current_user.admin? || current_user.vet? %>

                <li class="nav-item">
                  <%= link_to "Owners",
                              owners_path,
                              class: "nav-link mx-2" %>
                </li>

              <% elsif current_user.owner? && current_user.owner.present? %>

                <li class="nav-item">
                  <%= link_to "My Account",
                              owner_path(current_user.owner),
                              class: "nav-link mx-2" %>
                </li>

              <% end %>

              <li class="nav-item">
                <%= link_to "Pets",
                            pets_path,
                            class: "nav-link mx-2" %>
              </li>

              <li class="nav-item">
                <%= link_to "Vets",
                            vets_path,
                            class: "nav-link mx-2" %>
              </li>

              <li class="nav-item">
                <%= link_to "Appointments",
                            appointments_path,
                            class: "nav-link mx-2" %>
              </li>

            <% end %>

          </ul>

          <!-- RIGHT AUTH LINKS -->
          <ul class="navbar-nav">

            <% if user_signed_in? %>

              <li class="nav-item">
                <span class="nav-link text-light">
                  <strong>
                    <%= current_user.full_name %>
                  </strong>
                </span>
              </li>

              <li class="nav-item">
                <%= button_to "Logout",
                              destroy_user_session_path,
                              method: :delete,
                              class: "btn btn-danger ms-2" %>
              </li>

            <% else %>

              <li class="nav-item">
                <%= link_to "Login",
                            new_user_session_path,
                            class: "nav-link mx-2" %>
              </li>

            <% end %>

          </ul>

        </div>
      </div>
    </nav>

    <!-- CONTENT -->
    <div class="container py-4">

      <!-- FLASH MESSAGES -->
      <%= render "layouts/flash" %>

      <%= yield %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  </body>
</html>