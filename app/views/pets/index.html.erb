<div class="d-flex justify-content-between align-items-center mb-4">

  <h1 class="mb-0 fw-bold">
    Pets
  </h1>

  <% if policy(Pet).new? %>

    <%= link_to "New Pet",
                new_pet_path,
                class: "btn btn-primary" %>

  <% end %>

</div>

<div class="table-responsive">

  <table class="table table-striped table-hover align-middle">

    <thead class="table-dark">
      <tr>
        <th>Photo</th>
        <th>Name</th>
        <th>Species</th>
        <th>Breed</th>
        <th>Owner</th>
        <th>Birth Date</th>
        <th class="text-center">Actions</th>
      </tr>
    </thead>

    <tbody>

      <% @pets.each do |pet| %>

        <tr>

          <!-- PHOTO -->
          <td>

            <% if pet.photo.attached? %>

              <%= image_tag pet.photo.variant(resize_to_fill: [60, 60]).processed,
                            class: "rounded shadow-sm",
                            style: "object-fit: cover;" %>

            <% else %>

              <span class="text-muted">
                No photo
              </span>

            <% end %>

          </td>

          <!-- NAME -->
          <td>

            <% if policy(pet).show? %>

              <%= link_to pet.name,
                          pet,
                          class: "fw-semibold text-decoration-none" %>

            <% else %>

              <%= pet.name %>

            <% end %>

          </td>

          <!-- SPECIES -->
          <td>

            <span class="badge bg-info text-dark">
              <%= pet.species %>
            </span>

          </td>

          <!-- BREED -->
          <td>
            <%= pet.breed %>
          </td>

          <!-- OWNER -->
          <td>

            <% if policy(pet.owner).show? %>

              <%= link_to "#{pet.owner.first_name} #{pet.owner.last_name}",
                          pet.owner,
                          class: "text-decoration-none" %>

            <% else %>

              <%= "#{pet.owner.first_name} #{pet.owner.last_name}" %>

            <% end %>

          </td>

          <!-- DATE -->
          <td>
            <%= pet.date_of_birth&.strftime("%B %d, %Y") %>
          </td>

          <!-- ACTIONS -->
          <td class="text-center">

            <div class="d-flex justify-content-center gap-2">

              <% if policy(pet).show? %>

                <%= link_to "Show",
                            pet,
                            class: "btn btn-sm btn-outline-info" %>

              <% end %>

              <% if policy(pet).edit? %>

                <%= link_to "Edit",
                            edit_pet_path(pet),
                            class: "btn btn-sm btn-outline-warning" %>

              <% end %>

              <% if policy(pet).destroy? %>

                <%= button_to "Delete",
                              pet,
                              method: :delete,
                              data: { turbo_confirm: "Are you sure?" },
                              form: { class: "d-inline" },
                              class: "btn btn-sm btn-outline-danger" %>

              <% end %>

            </div>

          </td>

        </tr>

      <% end %>

    </tbody>

  </table>

</div>